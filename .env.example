# Copy to .env and fill in. Never put real keys in this file (it is meant to be committed).
# OpenRouter key: Jev-compatible decision models on OpenRouter's Decisions API (default decision model).
OPENROUTER_API_KEY=
# Decision model and endpoint for the Jev-compatible (/v1/systemone) client.
CTE_SYSTEMONE_MODEL=inception/mercury-decide:free
CTE_SYSTEMONE_URL=https://openrouter.ai/api/alpha/decisions
# Optional: OpenAI Decisions API, log-prob baseline and agent model.
OPENAI_API_KEY=
CTE_DECISIONS_MODEL=gpt-6-luna
CTE_LOGPROB_MODEL=gpt-4.1-mini
CTE_AGENT_MODEL=gpt-5-mini
